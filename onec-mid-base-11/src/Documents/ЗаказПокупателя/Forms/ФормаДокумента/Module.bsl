#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДополнитьФормуЗаказПокупателя(Форма)
    
	// Начало доработки Савельева 17.08.2026 Вывести Поле Согласованная скидка, команда пересчет суммы строк ТЧ
	Если Форма.Элементы.Найти("ПолеСогласованнаяСкидка") <> Неопределено Тогда
        Возврат;
    КонецЕсли;
     
    Родитель = Форма.Элементы.Найти("ГруппаШапкаЛево");
    Если Родитель = Неопределено Тогда
        Родитель = Форма;
    КонецЕсли;
    
    ПолеВвода = Форма.Элементы.Добавить("ПолеСогласованнаяСкидка", Тип("ПолеФормы"), Родитель);
    ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
    ПолеВвода.Заголовок = "Согласованная скидка";
    ПолеВвода.ПутьКДанным = "Объект.СогласованнаяСкидка";
	ПолеВвода.Ширина = 15; 
	ПолеВвода.УстановитьДействие("ПриИзменении","СогласованнаяСкидкаПриИзменении");
	
	// Создаём команду
	Команда = Команды.Добавить("Обн");
	Команда.Заголовок = "ОбновитьВсеСтроки";
	Команда.Действие = "КомандаОбновитьВсеСтроки";
    
	// Добавляем кнопку
	Кнопка = Элементы.Добавить("КнопкаОбновитьВсеСтроки", Тип("КнопкаФормы"),Родитель);
	Кнопка.ИмяКоманды = "Обн";
    Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	Кнопка.Заголовок = "ОбновитьВсеСтроки";
	       
   	// Савельева 17.08.2026 Конец Доработки   

КонецПроцедуры

&НаКлиенте
Процедура СогласованнаяСкидкаПриИзменении(Элемент)
	// Начало доработки Савельева 20.06.2026 Пересчёте ТЧ с вопросом
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		РассчитатьСуммуДокумента();
		Возврат;
	КонецЕсли;	
	
	ПоказатьВопрос(
	Новый ОписаниеОповещения("НаВопросОПересчётеЗавершение", ЭтотОбъект),
	"Изменена скидка. Пересчитать суммы в табличных частях?",
	РежимДиалогаВопрос.ДаНет
	); 
	//Конец Доработки Савельева 20.06.2026
КонецПроцедуры  

&НаКлиенте
Процедура НаВопросОПересчётеЗавершение(Результат, ДополнительныеПараметры)  экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
        СуммаСтрокПоТабличнымЧастям();
	Иначе
        РассчитатьСуммуДокумента();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьВсеСтроки(Команда)

// Начало доработки Савельева 20.06.2026 Создание команды Обновить строки в ТЧ при изменении скидки	
	ПересчитатьВсеСтроки();
//Конец доработки Савельева 20.06.2026
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсеСтроки()
    СуммаСтрокПоТабличнымЧастям();
    РассчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура СуммаСтрокПоТабличнымЧастям()
// пересчет для определенного вида строк	
	Для Каждого СтрокаТовара Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТовара);
	КонецЦикла;
	
	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаУслуги);
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	//Начало Доработки Савельева 17.08.2026 изменение расчета суммы строки с добавлением скидки
	СкидкаШапка = Объект.СогласованнаяСкидка; 
	СкидкиТЧ = ТекущиеДанные.Скидка;
	ИтоговаяСкидка = СкидкаШапка+СкидкиТЧ;
	
	Если ИтоговаяСкидка > 100 тогда
		ИтоговаяСкидка = 100;
	КонецЕсли;

	ТекущиеДанные.Сумма = Окр(ТекущиеДанные.Количество*ТекущиеДанные.Цена*(1- ИтоговаяСкидка/100),2);

	//КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	//ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;//Скидка = Объект.СогласованнаяСкидка; 
	
	РассчитатьСуммуДокумента();
	// Конец Доработки Савельева 17.08.2026
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

